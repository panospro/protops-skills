{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 ~/.codex/hooks/log-subagent.py", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 ~/.codex/hooks/log-subagent.py", "timeout": 10 }
        ]
      }
    ]
  }
}
